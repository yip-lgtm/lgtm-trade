# Markov BTC Trader - Configuration
# Copy this to .env and fill in your values

# === REQUIRED - WILL BE PROVIDED ===
PRIVATE_KEY=

# === POLYMARKET CLOB API ===
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
CLOB_ENDPOINT=https://clob.polymarket.com
CLOB_CHAIN_ID=137  # Polygon mainnet

# === DRY RUN (testing mode) ===
DRY_RUN=true

# === TRADING PARAMETERS (auto-tuned nightly) ===
MIN_PROB=0.87
MIN_EDGE=0.03

# === MARKOV CHAIN SETTINGS ===
MARKOV_STATE_N=3
LOOKBACK_CANDLES=30
KLINE_INTERVAL=300  # 5 minutes in seconds

# === NOTIFICATION ===
TELEGRAM_BOT_TOKEN=8983362178:AAGBWt98Zy1zjaEFPAclIjtDr0HyMjUCnpk
TELEGRAM_CHAT_ID=<YOUR_CHAT_ID>

# === SERVER ===
SERVER_PORT=3000
SERVER_HOST=0.0.0.0