# =============================================
# BTC 5m Trader - Environment Config Template
# Copy this to config/.env and fill in values
# =============================================

# === REQUIRED - Wallet & Trading ===
POLYCLAW_PRIVATE_KEY=
RELAYER_API_KEY_ADDRESS=

# === REQUIRED - Telegram Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === TRADING MODE ===
DRY_RUN=true

# === TRADING THRESHOLDS ===
MIN_PROB=0.87
MIN_EDGE=0.03
MAX_POSITION=5.0
MAX_DAILY_LOSS=30.0
CHECK_INTERVAL=81
STATE_WINDOW=4

# === MARKET FILTERS ===
ATR_MULT=0.8
VOL_MULT=0.6

# === AUTO-TUNING ===
TARGET_CYCLES=50

# === STATE FILES ===
STATE_FILE=/home/node/.openclaw/workspace/btc_5m_state.json
CONFIG_FILE=/home/node/.openclaw/workspace/btc_5m_config.json